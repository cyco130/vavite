{
  "name": "vavite",
  "version": "7.0.1",
  "description": "vavite",
  "keywords": [
    "nextjs",
    "react",
    "ssr",
    "vite"
  ],
  "license": "MIT",
  "repository": "github:cyco130/vavite",
  "files": [
    "dist",
    "*.d.ts"
  ],
  "type": "module",
  "typesVersions": {
    "*": {
      "*": [
        "dist/*.d.ts"
      ]
    }
  },
  "exports": {
    ".": "./dist/index.js",
    "./types": "./types.d.ts"
  },
  "scripts": {
    "build": "tsdown --clean",
    "dev": "tsdown --watch",
    "prepack": "pnpm build",
    "test": "pnpm run /^test:/",
    "test:typecheck": "tsc -p tsconfig.json",
    "test:lint": "eslint . --max-warnings 0",
    "test:package": "publint"
  },
  "dependencies": {
    "http-proxy-3": "^1.23.3"
  },
  "devDependencies": {
    "@cyco130/eslint-config": "^9.0.2",
    "@types/node": "^22.19.20",
    "eslint": "^10.4.1",
    "publint": "^0.3.21",
    "tsdown": "0.22.2",
    "typescript": "^7.0.2",
    "vite": "^8.0.16"
  },
  "peerDependencies": {
    "vite": "~7.3 || 8"
  },
  "engines": {
    "node": "22 || 24 || 25 || 26"
  }
}
